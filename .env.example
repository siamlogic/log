# Environment variables template for CBT Activity Record System
# Copy this file to .env or set these in your hosting environment

# Database connection (SQLite file path for single server / WAL mode)
DATABASE_URL="file:./dev.db"

# Session secret (min 32 characters, used for HMAC-SHA256 cookie signing)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="replace-with-a-secure-random-secret-at-least-32-chars"

# App URL
NEXTAUTH_URL="http://localhost:3000"

# MFA AES-256-GCM Master Encryption Key (64 hex characters = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Node environment (development / production / test)
NODE_ENV="development"
